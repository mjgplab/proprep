! TEMPLATE: Standard Production
! DESCRIPTION: Standard production MD at 300K and 1 atm with 4fs timestep for 500ps
! TYPE: production
! PRIORITY: 1
! AUTHOR: Erika McCarthy, Şölen Ekesan, and Darrin M. York
! VERSION: 1.0
! SOURCE: Adapted from https://ambertutorials-rutgerslbsr-c744272d5a9c1169e0dc9e19b8d800019105.gitlab.io/workshop/02_intoMD/MTR1/Build_MTR1.html

Production Stage. Hold at 300K and 1 atm for 100 ns.

&cntrl
! Run Control
  imin = 0,			! Molecular dynamics (0=MD, 1=minimization)
  nstlim = 50000000,		! Total MD steps
  dt = 0.002,			! 0.002 ps time step (2 fs)

! Input_Output Control
  ntx = 5,			! Read coordinates and/or velocities: 1 = start, 5 = restart
  irest = 1,                    ! Start or Restart simulation       : 0 = start, 1 = restart
  ntpr = 10000,			! Every ntpr steps, print human-readable energy info
  ntwx = 10000,			! Every ntwx steps, print coordinates to mdcrd file
  ntwr = 10000,                 ! Every ntwr steps, print coordinates to restart file
  ioutfm = 1,                   ! NetCDF binary trajectory format (compact, portable)

! Restraints
  ntr = 0,                              ! No positional restraints

! Temperature Control
  ntt = 3,			! Langevin thermostat (0=none, 1=Berendsen, 2=Anderson, 3=Langevin)
  gamma_ln = 5.0,		! Collision frequency (1/ps) for Langevin thermostat
  ig=-1,			! Random seed from wall clock (ensures unique trajectory per run)
  tempi = 300,			! Initial temperature (K)
  temp0 = 300,			! Target temperature (K)

! Pressure Control
  ntp = 1,			! Isotropic pressure coupling (0=none, 1=isotropic, 2=anisotropic)
  barostat = 2,			! Monte Carlo barostat (1=Berendsen, 2=Monte Carlo)
  pres0 = 1.0,			! Reference pressure (in bar)
  taup = 1.0,			! Pressure relaxation time

! Miscellaneous
  cut = 12.0,			! Nonbonded interaction cutoff (Angstroms)
  nscm = 100                    ! Remove center-of-mass translation every 100 steps


! Periodic Boundary Conditions
  ntb = 2,			! Periodic boundaries, constant pressure
  iwrap = 0,			! Do not wrap coordinates

! SHAKE
  ntc = 2,			! SHAKE constraints on bonds involving hydrogen
  ntf = 2,			! Omit bond forces for SHAKE-constrained bonds
/

