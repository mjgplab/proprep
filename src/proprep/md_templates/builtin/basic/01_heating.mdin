! TEMPLATE: Metalloprotein Heating
! DESCRIPTION: Gradual heating from 0-300K for metalloproteins with temperature ramping
! TYPE: heating
! PRIORITY: 1
! AUTHOR: Matthew J. Guberman-Pfeffer
! VERSION: 1.0
! SOURCE: Experience-based protocol for aqueous metalloprotein systems

Heating Stage in Explicit Solvent
Gradual temperature increase from 0 to 300K over 1 ns with light restraints

&cntrl
  ! Temperature Control
  ntt=3,                           ! Langevin thermostat (0=none, 1=Berendsen, 2=Anderson, 3=Langevin)
  tempi=0,                         ! Initial temperature (K)
  temp0=300.0,                     ! Target temperature (K)
  gamma_ln=5.0,                    ! Collision frequency (1/ps) for Langevin thermostat
  ig=-1,                           ! Random seed from wall clock (ensures unique trajectory per run)

  ! Constraints
  ntc=2,                           ! SHAKE constraints on bonds involving hydrogen
  ntf=2,                           ! Omit bond forces for SHAKE-constrained bonds

  ! System Control
  ntb=1,                           ! Periodic boundaries, constant volume
  cut=10.0,                        ! Nonbonded interaction cutoff (Angstroms)

  ! Time Control
  dt=0.002,                        ! 0.002 ps time step (2 fs)
  nstlim=1000000,                  ! Total MD steps (2 ns total)

  ! Output Control
  ntwr=10000,                      ! Restart file write frequency
  ntwx=10000,                      ! Trajectory write frequency
  ntpr=10000,                      ! Energy output frequency
  ioutfm=1,                        ! NetCDF binary trajectory format (compact, portable)
  iwrap=1,                         ! Wrap coordinates into primary box

  ! Restraints
  ntr=1,                           ! Enable positional restraints (see restraintmask below)
  restraint_wt=1.0,                ! Restraint force constant (kcal/mol-A2)
  restraintmask='@CA,C,O,N&!:WAT', ! Atoms to restrain (AMBER mask syntax)

  ! Temperature Ramping
  nmropt=1,                        ! Enable varying conditions via &wt blocks below (temperature ramps, etc.)
/

! Temperature ramping schedule
&wt                                            ! Temperature ramp: 0.0 to 300.0 over steps 0 to 500000
  TYPE='TEMP0', ISTEP1=0, ISTEP2=500000,
  VALUE1=0.0, VALUE2=300.0,
/
&wt                                            ! Hold at 300K for steps 500001 to 1000000
  TYPE='TEMP0', ISTEP1=500001, ISTEP2=1000000,
  VALUE1=300.0, VALUE2=300.0,
/
&wt
  TYPE='END'                                   ! End of varying conditions block
/

