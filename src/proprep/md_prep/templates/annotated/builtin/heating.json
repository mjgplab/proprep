{
  "name": "Heating Protocol",
  "description": "Gradual heating from 0 to 300K with restraints",
  "simulation_type": "heating",
  "parameters": {
    "imin": {
      "name": "imin",
      "value": 0,
      "description": "Molecular dynamics simulation (imin=0)",
      "typical_values": [
        "0"
      ],
      "warnings": [],
      "dependencies": [],
      "category": "simulation_control"
    },
    "ntx": {
      "name": "ntx",
      "value": 1,
      "description": "Read coordinates only (new simulation)",
      "typical_values": [
        "1",
        "5"
      ],
      "warnings": [],
      "dependencies": [
        "irest"
      ],
      "category": "input_control"
    },
    "irest": {
      "name": "irest",
      "value": 0,
      "description": "Do not restart simulation (new start)",
      "typical_values": [
        "0",
        "1"
      ],
      "warnings": [],
      "dependencies": [
        "ntx"
      ],
      "category": "input_control"
    },
    "nstlim": {
      "name": "nstlim",
      "value": 50000,
      "description": "Number of MD steps (50k steps = 50 ps with dt=0.001)",
      "typical_values": [
        "25000",
        "50000",
        "100000"
      ],
      "warnings": [],
      "dependencies": [
        "dt"
      ],
      "category": "time_control"
    },
    "dt": {
      "name": "dt",
      "value": 0.001,
      "description": "Time step in ps (1 fs for heating)",
      "typical_values": [
        "0.001",
        "0.002"
      ],
      "warnings": [
        "Use 0.001 ps for heating phases",
        "0.002 ps requires SHAKE constraints"
      ],
      "dependencies": [],
      "category": "time_control"
    },
    "ntt": {
      "name": "ntt",
      "value": 3,
      "description": "Langevin thermostat (recommended)",
      "typical_values": [
        "1",
        "2",
        "3",
        "11"
      ],
      "warnings": [],
      "dependencies": [
        "gamma_ln",
        "temp0",
        "tempi"
      ],
      "category": "temperature"
